**/__pycache__/
*.pyc
*.csv

# IDE settings
.idea/
.vscode/

# Generated media files
media/*.png
*.pdf

# LibreOffice / editor lock files
*.~lock.*#

# Virtual envs and caches
# Sin barra final a proposito: git trata un symlink como fichero, no como
# directorio, asi que `.venv/` no lo cubre. Sin la barra se ignoran ambos.
.venv
venv
.mypy_cache/
.atl/
.pytest_cache/

# Local tool config
.lsp.json
.qwenignore

# Local secrets / environment
.env

# CodeGraph index (local, machine-specific)
.codegraph/

# Large local data (kept on disk, out of git)
maps.json
maps*.json
estados/

*.md
opencode.json